# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings -> API in the Supabase dashboard).
#
# The anon key is safe to expose in client-side code -- it only grants what
# your Row Level Security policies allow (see supabase/schema.sql).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
